#!/bin/sh
set -eu

if [ "$#" -lt 3 ]; then
    echo "Usage: odin-cross-link TARGET OBJECT OUTPUT [compiler/linker flags...]" >&2
    echo "Targets: linux-amd64, linux-arm64, windows-amd64 (experimental)" >&2
    exit 2
fi
target=$1
object=$2
output=$3
shift 3

# Call with a single object generated by Odin's -use-single-module.
# Additional target-specific foreign libraries must be supplied by the caller.
case "$target" in
linux-amd64 | linux-arm64)
    case "$target" in
    linux-amd64) zig_target=x86_64-linux-gnu ;;
    linux-arm64) zig_target=aarch64-linux-gnu ;;
    esac
    exec zig cc -target "$zig_target" "$object" -o "$output" "$@" -lm -lpthread -ldl
    ;;
windows-amd64)
    exec /opt/llvm-mingw/bin/x86_64-w64-mingw32-clang \
        "$object" /usr/local/share/ci-cross/odin-msvc-compat.c \
        -o "$output" "$@" -lkernel32 -luser32 -lshell32 -ladvapi32 -lbcrypt
    ;;
*)
    echo "Unsupported target: $target" >&2
    exit 2
    ;;
esac
